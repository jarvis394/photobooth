{
  "name": "@valley/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "swc src/* --watch --out-dir dist",
    "build": "tsc -b -v",
    "lint": "eslint . --max-warnings 0 --fix",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/src/*.js",
      "require": "./dist/src/*.js"
    }
  },
  "dependencies": {
    "@valley/db": "*",
    "@valley/ui": "*",
    "@valley/shared": "*",
    "@dotenvx/dotenvx": "^1.48.1",
    "better-auth": "^1.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@react-email/components": "^0.3.2"
  },
  "devDependencies": {
    "@valley/eslint-config": "*",
    "@valley/typescript-config": "*",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "eslint": "^8.56.11",
    "typescript": "^5.8.2"
  }
}
